# Copy to .env and fill locally. Never commit real values.

# App
NODE_ENV=development
PORT=5000

# PostgreSQL (placeholders only)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/kheyal_dev

# Frontend origin (used later for CORS / cookies)
FRONTEND_ORIGIN=http://localhost:3000

# Auth secret (storage method — cookie vs token — is still open; see PRD §20)
AUTH_SECRET=replace-me

# Web Push VAPID (generated later; placeholders only)
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:you@example.com
