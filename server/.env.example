# Environment configuration template for Kheyal Backend (server)
NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
DATABASE_URL=postgresql://kheyal_app:kheyal_dev_secret@localhost:5432/kheyal_dev

# Direct connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kheyal_dev
DB_USER=kheyal_app
DB_PASSWORD=kheyal_dev_secret

# Session Auth (Secret used for signing cookies/CSRF where needed)
SESSION_SECRET=replace_with_64_char_random_hex_for_production

# Frontend Origin for CORS & Cookies
FRONTEND_ORIGIN=http://localhost:3000

