# ==============================================================================
# Kheyal Backend Environment Variables Template
# NEVER commit the real .env file to version control.
# Copy this file to .env and supply actual values for your deployment.
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000

# PostgreSQL Connection String (Standard on cloud providers: Neon, Supabase, Railway)
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/kheyal_db?sslmode=require
DATABASE_URL=postgresql://kheyal_app:kheyal_dev_secret@localhost:5432/kheyal_dev
DATABASE_SSL=false

# Direct Database Connection Parameters (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kheyal_dev
DB_USER=kheyal_app
DB_PASSWORD=kheyal_dev_secret

# Session Auth (Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace_with_64_char_random_hex_for_production

# Frontend Origin for CORS & Cookies (Comma-separated for multiple origins if needed)
# In production on Vercel: https://kheyal.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# Web Push VAPID Configuration
# Generate production keys via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace_with_production_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_production_vapid_private_key
VAPID_SUBJECT=mailto:support@kheyal.app

# Optional Google OAuth Client ID for Google Login
GOOGLE_CLIENT_ID=
