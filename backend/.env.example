# =============================================================================
# Kheyal backend environment variables — TEMPLATE
# =============================================================================
# Copy this file to `backend/.env` and fill in real values.
# `.env` is git-ignored. NEVER commit real secrets. This file must only ever
# contain placeholders.
# =============================================================================

# --- Server ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# --- PostgreSQL (local development) ------------------------------------------
# Use the least-privilege app role created by
# backend/scripts/db/create-app-role.sql — NOT the `postgres` superuser.
# These standard PG* names are also understood natively by node-postgres.
PGHOST=localhost
PGPORT=5432
PGDATABASE=kheyal_dev
PGUSER=kheyal_app
PGPASSWORD=replace-with-your-kheyal_app-password
