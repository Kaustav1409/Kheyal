# Normalise line endings: store and check out text files with LF.
# Prevents noisy CRLF/LF diffs between Windows and Linux (CI, hosting).
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (never touched).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
